{
  "name": "targeted-cv-tooling",
  "private": true,
  "version": "2.0.0-alpha.2",
  "description": "Deterministic checks and release tooling for the targeted-cv skill; no application service",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "release:prepare": "node release/prepare.cjs",
    "release:check": "node release/check.cjs",
    "release:pipeline": "node release/pipeline.cjs",
    "release:test": "node --test tests/portable-skill-release/*.test.cjs",
    "release:validate": "node tests/portable-skill-release/full-acceptance.cjs",
    "release:retirement": "node release/retirement.cjs"
  },
  "license": "MIT"
}
