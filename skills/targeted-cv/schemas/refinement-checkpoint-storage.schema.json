{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:targeted-cv:refinement-checkpoint-storage:1.0",
  "title": "Private refinement checkpoint storage 1.0",
  "description": "Closed outer envelope for one versioned refinement checkpoint. The retained refinement-session 1.0 record travels as canonical base64 of its exact UTF-8 bytes; the payload digest is independent of the outer storage-file hash. Encoding is not encryption and this wrapper grants no authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "previous",
    "record_utf8_base64",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "refinement-checkpoint-storage"
    },
    "previous": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/artifactRef"
        }
      ]
    },
    "record_utf8_base64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolved_path",
        "sha256"
      ],
      "properties": {
        "resolved_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
