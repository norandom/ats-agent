{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Targeted CV release maintenance records (packaging records only)",
  "oneOf": [
    {
      "$ref": "#/$defs/candidate"
    },
    {
      "$ref": "#/$defs/prepared"
    },
    {
      "$ref": "#/$defs/artifact"
    },
    {
      "$ref": "#/$defs/check"
    }
  ],
  "$defs": {
    "candidate": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "candidate-declaration"
        },
        "name": {
          "const": "targeted-cv"
        },
        "version_source": {
          "const": "VERSION"
        },
        "scope": {
          "type": "array",
          "items": {
            "enum": [
              "profile",
              "strategy",
              "document-session",
              "documents",
              "refinement"
            ]
          },
          "minItems": 5,
          "uniqueItems": true
        },
        "contracts": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "array",
              "items": {
                "enum": [
                  "1.0",
                  "2.0",
                  "2.1"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "strategy": {
              "type": "array",
              "items": {
                "enum": [
                  "1.0",
                  "1.1",
                  "1.2"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "documents": {
              "type": "array",
              "items": {
                "enum": [
                  "1.0",
                  "1.1",
                  "1.2"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "document_session": {
              "type": "array",
              "items": {
                "const": "1.0"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "refinement_session": {
              "type": "array",
              "items": {
                "const": "1.0"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "refinement_checkpoint_storage": {
              "type": "array",
              "items": {
                "const": "1.0"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "profile",
            "strategy",
            "documents",
            "document_session",
            "refinement_session",
            "refinement_checkpoint_storage"
          ],
          "additionalProperties": false
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "enum": [
                  "portable-zip",
                  "skill-alias",
                  "plugin-zip"
                ]
              },
              "platform": {
                "enum": [
                  "windows",
                  "linux",
                  "unspecified"
                ]
              },
              "host": {
                "type": "string",
                "minLength": 1
              },
              "connection": {
                "type": "string",
                "minLength": 1
              },
              "javascript_runtime": {
                "enum": [
                  "host",
                  "external-node"
                ]
              },
              "layout_verified": {
                "enum": [
                  "passed",
                  "failed",
                  "not_assessed"
                ]
              },
              "host_load_verified": {
                "enum": [
                  "passed",
                  "failed",
                  "not_assessed"
                ]
              },
              "workflow_verified": {
                "enum": [
                  "passed",
                  "failed",
                  "not_assessed"
                ]
              },
              "evidence": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "size": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "path",
                      "sha256",
                      "size"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "format",
              "platform",
              "host",
              "connection",
              "javascript_runtime",
              "layout_verified",
              "host_load_verified",
              "workflow_verified",
              "evidence"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "applicant",
                  "maintenance",
                  "optional"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "version": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "command": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "role",
              "required",
              "version",
              "capabilities",
              "command"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "inventory_ref": {
          "const": "release/manifest.json"
        },
        "rights_ref": {
          "const": "release/rights.json"
        },
        "project_license": {
          "const": "MIT"
        },
        "publication": {
          "const": "separate-instruction-required"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "name",
        "version_source",
        "scope",
        "contracts",
        "targets",
        "prerequisites",
        "inventory_ref",
        "rights_ref",
        "project_license",
        "publication"
      ],
      "additionalProperties": false
    },
    "prepared": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "prepared-candidate"
        },
        "name": {
          "const": "targeted-cv"
        },
        "version": {
          "type": "string",
          "pattern": "^2\\.0\\.0-alpha\\.[1-9][0-9]*$"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "source_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "development_snapshot": {
          "type": "boolean"
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
              },
              "role": {
                "enum": [
                  "core",
                  "guide",
                  "sample",
                  "license",
                  "notice"
                ]
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "rights_ref": {
                "type": "string",
                "minLength": 1
              },
              "destinations": {
                "type": "object",
                "properties": {
                  "portable-zip": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "skill-alias": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "plugin-zip": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "portable-zip",
                  "skill-alias",
                  "plugin-zip"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "source",
              "role",
              "size",
              "sha256",
              "rights_ref",
              "destinations"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "build_inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "checkout_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256",
              "size",
              "checkout_sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "kind",
        "name",
        "version",
        "source_revision",
        "source_epoch",
        "development_snapshot",
        "assets",
        "build_inputs"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "artifact"
        },
        "name": {
          "const": "targeted-cv"
        },
        "version": {
          "type": "string",
          "pattern": "^2\\.0\\.0-alpha\\.[1-9][0-9]*$"
        },
        "format": {
          "enum": [
            "portable-zip",
            "skill-alias",
            "plugin-zip"
          ]
        },
        "filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "release_metadata_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "payload_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "build_input_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "name",
        "version",
        "format",
        "filename",
        "size",
        "sha256",
        "release_metadata_sha256",
        "payload_digest",
        "build_input_digest",
        "source_revision"
      ],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "check-result"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_assessed"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "observation_class": {
          "enum": [
            "actual",
            "control",
            "host_judgment"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path",
              "sha256",
              "size"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path",
              "sha256",
              "size"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": {
                "enum": [
                  "definition",
                  "integrity",
                  "rights",
                  "prerequisite",
                  "evidence",
                  "destination",
                  "retirement"
                ]
              },
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "next_action": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "category",
              "scope",
              "next_action"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "kind",
        "status",
        "method",
        "observation_class",
        "scope",
        "inputs",
        "outputs",
        "limits",
        "issues"
      ],
      "additionalProperties": false
    }
  }
}
